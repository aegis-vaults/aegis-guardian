# Aegis Guardian Environment Configuration - DEVNET
# Generated: 2025-12-02
# This configuration is for the devnet deployment of Aegis Protocol

# ============================================
# Application Configuration
# ============================================
NODE_ENV=production
PORT=3000
BASE_URL=https://guardian-devnet.aegis.finance
APP_VERSION=1.0.0
LOG_LEVEL=info

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
# Update with your production database credentials
DATABASE_URL=postgresql://aegis_user:CHANGE_ME@your-db-host:5432/aegis_guardian_devnet?schema=public&sslmode=require

# Connection pool settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ============================================
# Redis Configuration
# ============================================
# Update with your production Redis credentials
REDIS_URL=redis://your-redis-host:6379

# ============================================
# Solana Configuration - DEVNET
# ============================================
# Devnet RPC endpoint (use a dedicated RPC provider for production)
# Options: https://api.devnet.solana.com (public, rate-limited)
#          https://devnet.helius.xyz (Helius)
#          https://devnet.rpcpool.com (RPCPool)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Program ID from aegis-protocol deployment
# This will be updated after deployment by solana-protocol-expert
PROGRAM_ID=ET9WDoFE2bf4bSmciLL7q7sKdeSYeNkWbNMHbAMBu2ZJ

# Network cluster
SOLANA_CLUSTER=devnet

# WebSocket URL for event listening
# Derived from RPC URL by replacing https:// with wss://
SOLANA_WS_URL=wss://api.devnet.solana.com

# ============================================
# Event Listener Configuration
# ============================================
# Enable event listener on startup
EVENT_LISTENER_ENABLED=true

# Event listener restart delay in ms (if connection drops)
EVENT_LISTENER_RESTART_DELAY=5000

# Maximum reconnection attempts before alerting
EVENT_LISTENER_MAX_RECONNECT_ATTEMPTS=10

# ============================================
# Background Jobs Configuration
# ============================================
# Enable background job processing
JOBS_ENABLED=true

# Job concurrency (number of jobs processed in parallel)
JOBS_CONCURRENCY=5

# Daily metrics update cron schedule (runs at midnight UTC)
METRICS_CRON_SCHEDULE=0 0 * * *

# ============================================
# API Configuration
# ============================================
# API rate limiting (requests per minute per IP)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# CORS allowed origins (comma-separated)
# Update with your frontend domains
CORS_ORIGINS=https://app-devnet.aegis.finance,https://devnet.aegis.finance

# ============================================
# Webhook Configuration
# ============================================
# Enable webhook notifications
WEBHOOKS_ENABLED=true

# Webhook retry configuration
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=1000

# Webhook timeout in ms
WEBHOOK_TIMEOUT=5000

# ============================================
# Notification Configuration
# ============================================
# Telegram bot token for notifications (optional)
TELEGRAM_BOT_TOKEN=

# SendGrid API key for email notifications (optional)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@aegis.finance

# ============================================
# Blink/Actions Configuration
# ============================================
# Public URL for Blink action endpoints
ACTIONS_BASE_URL=https://guardian-devnet.aegis.finance/api/actions

# Default icon URLs for Blinks
BLINK_ICON_VAULT=https://guardian-devnet.aegis.finance/icons/aegis-vault.png
BLINK_ICON_SHIELD=https://guardian-devnet.aegis.finance/icons/aegis-shield.png
BLINK_ICON_BLOCKED=https://guardian-devnet.aegis.finance/icons/aegis-blocked.png

# ============================================
# Security Configuration
# ============================================
# JWT secret for authentication (MUST CHANGE - generate with: openssl rand -base64 32)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# HMAC secret for webhook signatures (MUST CHANGE - generate with: openssl rand -base64 32)
WEBHOOK_HMAC_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# Session timeout in seconds (1 hour)
SESSION_TIMEOUT=3600

# ============================================
# Monitoring & Observability
# ============================================
# Sentry DSN for error tracking (highly recommended for production)
SENTRY_DSN=

# Enable performance monitoring (0.0 to 1.0, recommend 0.1 for production)
SENTRY_TRACES_SAMPLE_RATE=0.1

# Enable request tracing
REQUEST_TRACING_ENABLED=true

# ============================================
# Feature Flags
# ============================================
# Enable experimental features (disable in production)
EXPERIMENTAL_FEATURES_ENABLED=false

# Enable analytics aggregation
ANALYTICS_ENABLED=true

# Enable Blink generation
BLINK_GENERATION_ENABLED=true

# ============================================
# Stripe Configuration (Optional)
# ============================================
# Stripe secret key for API access
STRIPE_SECRET_KEY=

# Webhook secret for verifying Stripe webhook signatures
STRIPE_WEBHOOK_SECRET=

# Price IDs for each subscription tier
STRIPE_PERSONAL_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
