# Aegis Guardian Environment Configuration

# ============================================
# Application Configuration
# ============================================
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
APP_VERSION=1.0.0
LOG_LEVEL=info

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
# Connection string format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aegis_guardian?schema=public

# Connection pool settings (optional)
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

# ============================================
# Redis Configuration
# ============================================
# Connection string format: redis://[username]:[password]@[host]:[port]/[database]
REDIS_URL=redis://localhost:6379

# ============================================
# Solana Configuration
# ============================================
# RPC endpoint (localnet, devnet, testnet, or mainnet-beta)
# For local development/testing, use: http://127.0.0.1:8899
# For devnet, use: https://api.devnet.solana.com
SOLANA_RPC_URL=http://127.0.0.1:8899

# Program ID of deployed aegis-protocol
# Example: ET9WDoFE2bf4bSmciLL7q7sKdeSYeNkWbNMHbAMBu2ZJ
PROGRAM_ID=ET9WDoFE2bf4bSmciLL7q7sKdeSYeNkWbNMHbAMBu2ZJ

# Network cluster (localnet | devnet | testnet | mainnet-beta)
SOLANA_CLUSTER=localnet

# ============================================
# Event Listener Configuration
# ============================================
# Enable/disable event listener on startup
EVENT_LISTENER_ENABLED=true

# Event listener restart delay in ms (if connection drops)
EVENT_LISTENER_RESTART_DELAY=5000

# ============================================
# Background Jobs Configuration
# ============================================
# Enable/disable background job processing
JOBS_ENABLED=true

# Job concurrency (number of jobs processed in parallel)
JOBS_CONCURRENCY=5

# Daily metrics update cron schedule (runs at midnight UTC)
METRICS_CRON_SCHEDULE=0 0 * * *

# ============================================
# API Configuration
# ============================================
# API rate limiting (requests per minute per IP)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# ============================================
# Webhook Configuration
# ============================================
# Enable/disable webhook notifications
WEBHOOKS_ENABLED=true

# Webhook retry configuration
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=1000

# Webhook timeout in ms
WEBHOOK_TIMEOUT=5000

# ============================================
# Notification Configuration
# ============================================
TELEGRAM_BOT_TOKEN=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@aegis.finance

# ============================================
# Blink/Actions Configuration
# ============================================
# Public URL for Blink action endpoints
ACTIONS_BASE_URL=http://localhost:3000/api/actions

# Default icon URLs for Blinks
BLINK_ICON_VAULT=http://localhost:3000/icons/aegis-vault.png
BLINK_ICON_SHIELD=http://localhost:3000/icons/aegis-shield.png
BLINK_ICON_BLOCKED=http://localhost:3000/icons/aegis-blocked.png

# ============================================
# Security Configuration
# ============================================
# JWT secret for authentication (generate with: openssl rand -base64 32)
JWT_SECRET=

# HMAC secret for webhook signatures (generate with: openssl rand -base64 32)
WEBHOOK_HMAC_SECRET=

# Session timeout in seconds
SESSION_TIMEOUT=3600

# ============================================
# Monitoring & Observability
# ============================================
# Sentry DSN for error tracking (optional)
# SENTRY_DSN=

# Enable performance monitoring
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Enable request tracing
REQUEST_TRACING_ENABLED=false

# ============================================
# Feature Flags
# ============================================
# Enable experimental features
EXPERIMENTAL_FEATURES_ENABLED=false

# Enable analytics aggregation
ANALYTICS_ENABLED=true

# Enable Blink generation
BLINK_GENERATION_ENABLED=true

# ============================================
# Stripe Configuration
# ============================================
# Stripe secret key for API access (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...

# Webhook secret for verifying Stripe webhook signatures
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs for each subscription tier (create in Stripe Dashboard)
STRIPE_PERSONAL_PRICE_ID=price_...
STRIPE_TEAM_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...
