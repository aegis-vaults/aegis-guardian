# ============================================
# Aegis Guardian - Production Environment Template
# ============================================
# This file serves as a template for production environment variables
# Copy values to Railway environment variables in the dashboard
# Generated: 2025-12-02

# ============================================
# Application Configuration
# ============================================
NODE_ENV=production
PORT=3000
BASE_URL=https://your-guardian-app.railway.app
APP_VERSION=1.0.0
LOG_LEVEL=info

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
# Railway will automatically provide DATABASE_URL when you add PostgreSQL
# Format: postgresql://user:password@host:port/database?schema=public&sslmode=require
DATABASE_URL=${DATABASE_URL}

# Connection pool settings (adjust based on Railway plan and load)
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ============================================
# Redis Configuration
# ============================================
# Railway will automatically provide REDIS_URL when you add Redis
# Format: redis://default:password@host:port
REDIS_URL=${REDIS_URL}

# ============================================
# Solana Configuration - DEVNET
# ============================================
# Use a dedicated RPC provider with high rate limits for production
# Recommended providers:
#   - Helius: https://www.helius.dev/ (5M requests/month free tier)
#   - QuickNode: https://www.quicknode.com/ (10M requests/month free tier)
#   - Triton RPC Pool: https://rpcpool.com/
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_API_KEY
SOLANA_WS_URL=wss://devnet.helius-rpc.com/?api-key=YOUR_API_KEY

# Aegis Protocol Program ID (CONFIRMED DEPLOYED)
AEGIS_PROGRAM_ID=ET9WDoFE2bf4bSmciLL7q7sKdeSYeNkWbNMHbAMBu2ZJ
PROGRAM_ID=ET9WDoFE2bf4bSmciLL7q7sKdeSYeNkWbNMHbAMBu2ZJ

# Network cluster
SOLANA_CLUSTER=devnet

# ============================================
# Event Listener Configuration
# ============================================
# Enable event listener on startup (should be true for production)
EVENT_LISTENER_ENABLED=true

# Event listener restart delay in ms (if connection drops)
EVENT_LISTENER_RESTART_DELAY=5000

# Maximum reconnection attempts before alerting
EVENT_LISTENER_MAX_RECONNECT_ATTEMPTS=10

# ============================================
# Background Jobs Configuration (Bull/BullMQ)
# ============================================
# Enable background job processing
JOBS_ENABLED=true

# Job concurrency (number of jobs processed in parallel)
JOBS_CONCURRENCY=5

# Daily metrics update cron schedule (runs at midnight UTC)
METRICS_CRON_SCHEDULE=0 0 * * *

# ============================================
# API Configuration
# ============================================
# API rate limiting (requests per minute per IP)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# CORS allowed origins (comma-separated)
# Update with your actual frontend domains
CORS_ORIGINS=https://app.aegis.finance,https://aegis.finance,https://www.aegis.finance

# ============================================
# Webhook Configuration
# ============================================
# Enable webhook notifications
WEBHOOKS_ENABLED=true

# Webhook retry configuration
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=1000

# Webhook timeout in ms
WEBHOOK_TIMEOUT=5000

# ============================================
# Blink/Actions Configuration
# ============================================
# Public URL for Blink action endpoints (use your actual Railway URL)
ACTIONS_BASE_URL=https://your-guardian-app.railway.app/api/actions

# Default icon URLs for Blinks (ensure these files exist in public/)
BLINK_ICON_VAULT=https://your-guardian-app.railway.app/icons/aegis-vault.png
BLINK_ICON_SHIELD=https://your-guardian-app.railway.app/icons/aegis-shield.png
BLINK_ICON_BLOCKED=https://your-guardian-app.railway.app/icons/aegis-blocked.png

# ============================================
# Security Configuration (CRITICAL)
# ============================================
# JWT secret for authentication
# REQUIRED: Generate with: openssl rand -base64 32
# DO NOT use the example below - generate your own!
JWT_SECRET=GENERATE_WITH_openssl_rand_base64_32

# HMAC secret for webhook signatures
# REQUIRED: Generate with: openssl rand -base64 32
# DO NOT use the example below - generate your own!
WEBHOOK_HMAC_SECRET=GENERATE_WITH_openssl_rand_base64_32

# Session timeout in seconds (1 hour)
SESSION_TIMEOUT=3600

# ============================================
# Monitoring & Observability
# ============================================
# Sentry DSN for error tracking (HIGHLY RECOMMENDED)
# Sign up at https://sentry.io and create a project
# Leave empty to disable
SENTRY_DSN=

# Enable performance monitoring (0.0 to 1.0)
# Recommended: 0.1 for production (10% of transactions)
SENTRY_TRACES_SAMPLE_RATE=0.1

# Enable request tracing
REQUEST_TRACING_ENABLED=true

# ============================================
# Feature Flags
# ============================================
# Enable experimental features (DISABLE in production)
EXPERIMENTAL_FEATURES_ENABLED=false

# Enable analytics aggregation
ANALYTICS_ENABLED=true

# Enable Blink generation
BLINK_GENERATION_ENABLED=true

# ============================================
# Notification Configuration (Optional)
# ============================================
# Telegram bot token for notifications
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# SendGrid API key for email notifications
# Sign up at https://sendgrid.com
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@aegis.finance

# ============================================
# Stripe Configuration (Optional - for subscriptions)
# ============================================
# Stripe secret key for API access
STRIPE_SECRET_KEY=

# Webhook secret for verifying Stripe webhook signatures
STRIPE_WEBHOOK_SECRET=

# Price IDs for each subscription tier
STRIPE_PERSONAL_PRICE_ID=
STRIPE_TEAM_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# ============================================
# Next.js Configuration
# ============================================
# Public API URL for client-side requests
NEXT_PUBLIC_API_URL=https://your-guardian-app.railway.app
